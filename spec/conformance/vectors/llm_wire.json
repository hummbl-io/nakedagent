          ": boom"
        ]
      }
    },
    {
      "name": "http 401 on openai hints at the key variable",
      "api": "openai",
      "model": "gpt-x",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "host_path": "/v1",
      "server": [
        {
          "status": 401,
          "body": "nope"
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/v1/chat/completions",
