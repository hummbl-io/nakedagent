    {
      "name": "connection refused (ollama)",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "unreachable": true,
      "expect": {
        "requests": [],
        "error_contains": [
          "could not reach Ollama at http://HOST:PORT",
          "Is `ollama serve` running?"
        ]
      }
    },
    {
      "name": "connection refused (openai)",
      "api": "openai",
      "model": "gpt-x",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "unreachable": true,
      "expect": {
        "requests": [],
        "error_contains": [
          "could not reach OpenAI-compatible API at http://HOST:PORT"
        ],
        "error_absent": [
          "ollama serve"
        ]
      }
    },
    {
      "name": "host scheme must be http or https",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "host": "file:///etc/passwd",
      "expect": {
        "requests": [],
        "error_contains": [
          "--host must be an http:// or https:// URL, got: 'file:///etc/passwd'"
        ]
      }
    },
    {
      "name": "host must have a network location",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "host": "http://",
      "expect": {
        "requests": [],
        "error_contains": [
          "--host must be an http:// or https:// URL"
        ]
      }
    },
    {
      "name": "unknown api is rejected",
      "api": "bogus",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "host": "http://localhost:1",
      "expect": {
        "requests": [],
        "error_contains": [
          "--api must be one of ollama, openai, got: 'bogus'"
        ]
      }
    },
    {
      "name": "credentials are not forwarded across a redirect",
      "api": "openai",
      "model": "gpt-x",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "env": {
        "OPENAI_API_KEY": "sk-test-1"
      },
      "host_path": "/v1",
      "server": [
        {
          "status": 302,
          "headers": {
            "Location": "/final"
          },
          "body": ""
        },
        {
          "status": 200,
          "body": {
            "choices": [
              {
                "message": {
                  "content": "hello there"
                }
              }
            ]
          }
        }
      ],
      "lenient_requests": true,
      "expect": {
        "first_request": {
          "method": "POST",
          "path": "/v1/chat/completions",
          "body": {
            "model": "gpt-x",
            "messages": [
              {
                "role": "system",
                "content": "sys"
              },
              {
                "role": "user",
                "content": "hi"
              }
            ],
            "stream": false
          },
          "authorization": "Bearer sk-test-1"
        },
        "later_requests_have_no_authorization": true
      }
    }
  ]
}
