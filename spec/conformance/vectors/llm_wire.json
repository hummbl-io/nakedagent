    {
      "name": "http 500 with body",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "server": [
        {
          "status": 500,
          "body": "boom"
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/api/chat",
            "body": {
