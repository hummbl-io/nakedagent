{
  "suite": "llm_wire",
  "cases": [
    {
      "name": "ollama request shape and reply",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "server": [
        {
          "status": 200,
          "body": {
            "message": {
              "content": "hello there"
            }
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/api/chat",
            "body": {
              "model": "m1",
              "messages": [
                {
                  "role": "system",
                  "content": "sys"
                },
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": false,
              "think": false
            },
            "authorization": null
          }
        ],
        "reply": "hello there"
      }
    },
    {
      "name": "ollama never sends credentials even if the env var is set",
      "api": "ollama",
      "model": "m1",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "env": {
        "OPENAI_API_KEY": "sk-test-1"
      },
      "server": [
        {
          "status": 200,
          "body": {
            "message": {
              "content": "hello there"
            }
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/api/chat",
            "body": {
              "model": "m1",
              "messages": [
                {
                  "role": "system",
                  "content": "sys"
                },
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": false,
              "think": false
            },
            "authorization": null
          }
        ],
        "reply": "hello there"
      }
    },
    {
      "name": "openai request shape, path and bearer key",
      "api": "openai",
      "model": "gpt-x",
      "messages": [
        {
          "role": "system",
          "content": "sys"
        },
        {
          "role": "user",
          "content": "hi"
        }
      ],
      "env": {
        "OPENAI_API_KEY": "sk-test-1"
      },
      "host_path": "/v1",
      "server": [
        {
          "status": 200,
          "body": {
            "choices": [
              {
                "message": {
                  "content": "hello there"
                }
              }
            ]
          }
        }
      ],
      "expect": {
        "requests": [
          {
            "method": "POST",
            "path": "/v1/chat/completions",
            "body": {
              "model": "gpt-x",
              "messages": [
                {
                  "role": "system",
                  "content": "sys"
                },
                {
                  "role": "user",
                  "content": "hi"
                }
              ],
              "stream": false
            },
            "authorization": "Bearer sk-test-1"
          }
        ],
        "reply": "hello there"
      }
    },
    {
      "name": "openai trailing slash on host is normalised",
      "api": "openai",
      "model": "gpt-x",
